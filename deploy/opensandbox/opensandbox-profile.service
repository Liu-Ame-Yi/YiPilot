[Unit]
Description=OpenSandbox 1.1.1 with the fixed YiPilot execution profile
Requires=yipilot-sandbox-network.service
After=yipilot-sandbox-network.service
BindsTo=docker.service
PartOf=docker.service

[Service]
Type=simple
User=root
UMask=0077
Environment=PYTHONPATH=/opt/opensandbox/yipilot-profile
ExecStartPre=/usr/bin/python3 /opt/opensandbox/yipilot-profile/deploy/network.py
ExecStart=/opt/opensandbox/venv/bin/opensandbox-server --config /etc/opensandbox/yipilot-profile.toml
Restart=on-failure
RestartSec=3
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
